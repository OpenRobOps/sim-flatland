From 517875118cef98fef6f303a4c26158e08e7ba53a Mon Sep 17 00:00:00 2001
From: Flatland Patcher <patcher@openrobops.local>
Date: Thu, 27 Aug 2026 13:47:49 -0300
Subject: [PATCH] diff_drive/tricycle_drive: publish odometry twist in the body
 frame

Box2D's GetLinearVelocityFromLocalPoint() returns the point's velocity in world
coordinates, so /odom twist.linear was the world-frame velocity (negative x when
driving west). nav_msgs/Odometry requires the twist in child_frame_id, i.e. the
robot body (x forward). Rotate it by -yaw before filling the message; the
separate 'twist' topic already did this and now just copies the value.
---
 flatland_plugins/src/diff_drive.cpp     | 12 ++++++++----
 flatland_plugins/src/tricycle_drive.cpp |  8 +++++++-
 2 files changed, 15 insertions(+), 5 deletions(-)

diff --git a/flatland_plugins/src/diff_drive.cpp b/flatland_plugins/src/diff_drive.cpp
index 50101c0..8c6022e 100644
--- a/flatland_plugins/src/diff_drive.cpp
+++ b/flatland_plugins/src/diff_drive.cpp
@@ -175,8 +175,14 @@ void DiffDrive::BeforePhysicsStep(const Timekeeper& timekeeper) {
 
   if (publish) {
     // get the state of the body and publish the data
-    b2Vec2 linear_vel_local =
+    // Box2D returns the velocity of a local point in WORLD coordinates despite the
+    // name; nav_msgs/Odometry.twist must be expressed in child_frame_id (the body),
+    // so rotate it into the body frame: x forward, y left.
+    b2Vec2 linear_vel_world =
         b2body->GetLinearVelocityFromLocalPoint(b2Vec2(0, 0));
+    b2Vec2 linear_vel_local(
+        cos(angle) * linear_vel_world.x + sin(angle) * linear_vel_world.y,
+        -sin(angle) * linear_vel_world.x + cos(angle) * linear_vel_world.y);
     float angular_vel = b2body->GetAngularVelocity();
 
     ground_truth_msg_.header.stamp = timekeeper.GetSimTime();
@@ -219,9 +225,7 @@ void DiffDrive::BeforePhysicsStep(const Timekeeper& timekeeper) {
       twist_pub_msg.header.frame_id = odom_msg_.child_frame_id;
 
       // Forward velocity in twist.linear.x
-      twist_pub_msg.twist.linear.x = cos(angle) * linear_vel_local.x +
-                                     sin(angle) * linear_vel_local.y +
-                                     noise_gen_[3](rng_);
+      twist_pub_msg.twist.linear.x = linear_vel_local.x + noise_gen_[3](rng_);
 
       // Angular velocity in twist.angular.z
       twist_pub_msg.twist.angular.z = angular_vel + noise_gen_[5](rng_);
diff --git a/flatland_plugins/src/tricycle_drive.cpp b/flatland_plugins/src/tricycle_drive.cpp
index ecdf9c8..4122861 100644
--- a/flatland_plugins/src/tricycle_drive.cpp
+++ b/flatland_plugins/src/tricycle_drive.cpp
@@ -300,8 +300,14 @@ void TricycleDrive::BeforePhysicsStep(const Timekeeper& timekeeper) {
   if (publish) {
     // 1. get the state of the body and publish the data,
     //    before the tricycle physics get updated
-    b2Vec2 linear_vel_local =
+    // Box2D returns the velocity of a local point in WORLD coordinates despite the
+    // name; nav_msgs/Odometry.twist must be expressed in child_frame_id (the body),
+    // so rotate it into the body frame: x forward, y left.
+    b2Vec2 linear_vel_world =
         b2body->GetLinearVelocityFromLocalPoint(b2Vec2(0, 0));
+    b2Vec2 linear_vel_local(
+        cos(angle) * linear_vel_world.x + sin(angle) * linear_vel_world.y,
+        -sin(angle) * linear_vel_world.x + cos(angle) * linear_vel_world.y);
     float angular_vel = b2body->GetAngularVelocity();
 
     ground_truth_msg_.header.stamp = timekeeper.GetSimTime();
-- 
